ADMIN_PASSWORD=change-me-to-a-strong-password
SECRET_KEY=change-me-to-a-long-random-hex-string

# --- Company contact (shown on the site) ------------------------------
# Displayed in the footer and used as Reply-To on customer email.
COMPANY_EMAIL=vaibhavreddy@gvminfradevelopers.com
SITE_URL=https://www.gvminfradevelopers.com

# --- Email sending (customer welcome mail + security alerts) ----------
# One SMTP setup powers both. Best deliverability: use a mailbox on your own
# domain (Google Workspace) as SMTP_USER, so mail comes FROM your company
# address instead of a gmail.com one.

# --- Security alert emails (optional) ---------------------------------
# Where to send "malicious activity" alerts. Leave ALERT_EMAIL blank and
# everything is still detected, logged and shown on the Admin dashboard —
# just not emailed.
ALERT_EMAIL=you@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
# Gmail requires a 16-character App Password, NOT your normal password:
# Google Account -> Security -> 2-Step Verification -> App passwords
SMTP_PASS=your-16-char-app-password

# Set to 0 only if you are serving over plain HTTP (not recommended).
# SECURE_COOKIES=1
